# Lumière RMS — environment (all optional in development; settings.py has sane defaults)
DEBUG=1
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# Database (swap ENGINE for postgres in config/settings.py for multi-node installs)
DB_PATH=db.sqlite3

# Venue overrides — the Restaurant row in the DB wins over these
RMS_BRAND=Lumière
